# Local development only. The packaged app stores keys via Settings → API keys (clickify.env in app user data).
GROQ_API_KEY=gsk_...your-key-here
SARVAM_API_KEY=your-sarvam-key-here
GEMINI_API_KEY=your-gemini-key-here

# LLM_PROVIDER: groq (default, fastest) | gemini (use gemini-2.0-flash)
LLM_PROVIDER=groq
